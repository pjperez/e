{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "e",
  "version": "0.1.0",
  "identifier": "dev.e.harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "e",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
